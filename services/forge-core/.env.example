# Copy to .env in this directory. `forge` reads it automatically. Never commit .env.

# Model vendors. Two from different families make reviews independent.
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Local, free: install Ollama (https://ollama.com), then `ollama pull qwen2.5:14b`.
OLLAMA_BASE_URL=http://localhost:11434/v1

# QuickBooks Online app (Intuit developer portal, Keys & credentials).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:8765/callback
# true for the sandbox keys, false for production keys.
QBO_SANDBOX=true

# Where the firm's identity and pricing live. Copy firm.example.json to firm.json.
FORGE_FIRM=firm.json
